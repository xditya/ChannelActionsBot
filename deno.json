    "hono/deno": "npm:hono@^4.6.0/deno",
    "autoQuote": "https://deno.land/x/grammy_autoquote@v2.0.9/mod.ts",
    "hydrate": "https://deno.land/x/grammy_hydrate@v1.7.0/mod.ts",
    "i18n": "https://deno.land/x/grammy_i18n@v1.1.0/mod.ts",
    "language": "https://deno.land/x/language@v0.1.0/mod.ts",
